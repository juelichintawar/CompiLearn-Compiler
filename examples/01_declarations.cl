// Example 1: Variable Declarations and Basic Types
// Demonstrates int, float, string, and bool declarations and assignments.

int age = 21;
float pi = 3.14159;
string greeting = "Hello, CompiLearn!";
bool isActive = true;

int uninitializedVar;
uninitializedVar = 100;

print(greeting);
print(age);
print(pi);
print(isActive);
print(uninitializedVar);
